<% content_for :title, "戰情室 — 307 人時燃盡追蹤" %>

<header class="dashboard-header">
  <div class="header-top">
    <h1 class="dashboard-title">戰情室 <span>— 307 人時燃盡追蹤</span></h1>
    <button type="button" id="theme-toggle" class="theme-toggle" aria-label="切換至淺色模式">🌙 深色</button>
  </div>
</header>

<%# data-turbo-frame 讓送出只換掉下方 burndown-content frame 的內容，比照 305/306
    （dashboard／issues）既有做法：瀏覽器網址列不會被填入篩選參數，也不會觸發整頁導覽。 %>
<%= turbo_frame_tag "burndown-content" do %>
  <p class="breadcrumb">
    <%= link_to "入口頁", "/", class: "back-link", data: { turbo_frame: "_top" } %>
    <span class="breadcrumb-sep">›</span>
    <span class="breadcrumb-current">人時燃盡追蹤</span>
  </p>

  <% if @error.present? %>
    <div class="error-message">
      <strong>錯誤：</strong><%= @error %>
    </div>
  <% else %>
    <%= form_with url: "/burndown", method: :get, class: "project-selector",
                  data: { turbo_frame: "burndown-content" } do %>
      <div class="control-group">
        <label for="project">專案：</label>
        <%= select_tag :project,
                       options_for_select([["全部專案", ""]] + @projects.map { |p| [p, p] }, @selected_project) %>
      </div>

      <div class="control-group">
        <label for="assignee">人員：</label>
        <%= select_tag :assignee,
                       options_for_select([["全部人員", ""]] + @assignees.map { |a| [a, a] }, @selected_assignee) %>
      </div>

      <div class="control-group">
        <label for="status">狀態：</label>
        <%= select_tag :status,
                       options_for_select(
                         [ [ "進行中", "in_progress" ], [ "已完成", "done" ], [ "全部", "all" ] ],
                         @selected_status
                       ) %>
      </div>

      <%= submit_tag "套用篩選", class: "apply-filters-btn" %>
    <% end %>

    <section class="issue-section">
      <h2>議題燃盡狀態</h2>
      <% if @filtered_issues.empty? %>
        <p class="empty-state">目前無符合條件的議題</p>
      <% else %>
        <table class="project-tasks burndown-status-table">
          <thead>
            <tr>
              <th>議題</th>
              <th>負責人</th>
              <th>預估人時</th>
              <th>已消耗</th>
              <th>剩餘</th>
              <th>狀態</th>
            </tr>
          </thead>
          <tbody>
            <% @filtered_issues.each_with_index do |issue, index| %>
              <% status = burndown_status(issue) %>
              <tr>
                <td><%= "#{issue[:project]}／#{issue[:issue_title]}" %></td>
                <td><%= issue[:assignees].join("、") %></td>
                <td><%= issue[:estimated_hours] %></td>
                <td><%= burndown_consumed_hours(issue) || "—" %></td>
                <td><%= burndown_remaining_hours(issue) || "—" %></td>
                <td>
                  <span class="status-badge status-<%= status[:key] %>"><%= status[:label] %></span>
                  <a href="#burndown-issue-<%= index %>" class="back-link">查看趨勢圖 ↓</a>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <% @filtered_issues.each_with_index do |issue, index| %>
          <details class="burndown-chart-details" id="burndown-issue-<%= index %>">
            <summary><%= "#{issue[:project]}／#{issue[:issue_title]}（#{issue[:assignees].join('、')}）趨勢圖" %></summary>
            <%= render partial: "burndown_chart",
                       locals: {
                         title: "#{issue[:project]}／#{issue[:issue_title]}（#{issue[:assignees].join('、')}）",
                         actual_series: issue[:actual_series],
                         ideal_series: issue[:ideal_series]
                       } %>
            <% if issue[:assignees].size > 1 %>
              <%= render partial: "burndown_stacked_chart",
                         locals: { per_assignee: issue[:per_assignee], estimated_hours: issue[:estimated_hours] } %>
            <% end %>
          </details>
        <% end %>
      <% end %>
    </section>
  <% end %>
<% end %>
