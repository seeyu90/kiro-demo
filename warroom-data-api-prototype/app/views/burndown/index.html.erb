<% content_for :title, "戰情室 — 307 人時燃盡追蹤" %>

<header class="dashboard-header">
  <div class="header-top">
    <h1 class="dashboard-title">戰情室 <span>— 307 人時燃盡追蹤</span></h1>
    <button type="button" id="theme-toggle" class="theme-toggle" aria-label="切換至深色模式">☀️ 淺色</button>
  </div>
</header>

<%# data-turbo-frame 讓送出只換掉下方 burndown-content frame 的內容，比照 305/306
    （dashboard／issues）既有做法：瀏覽器網址列不會被填入篩選參數，也不會觸發整頁導覽。 %>
<%= turbo_frame_tag "burndown-content" do %>
  <p class="breadcrumb">
    <%= link_to "入口頁", "/", class: "back-link", data: { turbo_frame: "_top" } %>
    <span class="breadcrumb-sep">›</span>
    <span class="breadcrumb-current">人時燃盡追蹤</span>
  </p>

  <% if @error.present? %>
    <div class="error-message">
      <strong>錯誤：</strong><%= @error %>
    </div>
  <% else %>
    <%= form_with url: "/burndown", method: :get, class: "project-selector",
                  data: { turbo_frame: "burndown-content" } do %>
      <div class="control-group">
        <label for="project">專案：</label>
        <%= select_tag :project,
                       options_for_select([["全部專案", ""]] + @projects.map { |p| [p, p] }, @selected_project) %>
      </div>

      <div class="control-group">
        <label for="assignee">人員：</label>
        <%= select_tag :assignee,
                       options_for_select([["全部人員", ""]] + @assignees.map { |a| [a, a] }, @selected_assignee) %>
      </div>

      <div class="control-group">
        <label for="status">狀態：</label>
        <%= select_tag :status,
                       options_for_select(
                         [ [ "進行中", "in_progress" ], [ "已完成", "done" ], [ "全部", "all" ] ],
                         @selected_status
                       ) %>
      </div>

      <%# 依週欄位日期篩選顯示範圍，留白＝顯示全部週次。307 資料源鎖在單一年度分頁，
          無法跨年查詢，這裡只能篩「當年度已載入的週次」。 %>
      <%= render "shared/date_range_filter", from: @selected_from, to: @selected_to, min: nil, max: nil %>

      <%= submit_tag "套用篩選", class: "apply-filters-btn" %>
    <% end %>

    <section class="issue-section">
      <h2>議題燃盡狀態</h2>
      <% if @filtered_issues.empty? %>
        <p class="empty-state">目前無符合條件的議題</p>
      <% else %>
        <%# 這裡是 div/span 模擬的表格（不是真正的 <table>），因為每一列都要能展開一個完整的
            燃盡圖（<details>/<summary>），標準 <table> 的 <tr>/<td> 不容易讓一整列原生地
            展開／收合次要內容；改用真正 <table> 需要把 <details> 整個包進單一 <td colspan>
            裡、header 也要跟著改用真正的 <th>，是比這次要修的無障礙落差更大的重構，故先只
            補上 ARIA role（table／columnheader／row／cell），不動整體標記結構。 %>
        <div class="burndown-status-table" role="table" aria-label="議題燃盡狀態">
          <div class="burndown-status-row burndown-status-header" role="row">
            <span role="columnheader">議題</span>
            <span role="columnheader">負責人</span>
            <span role="columnheader">預估人時</span>
            <span role="columnheader">已消耗</span>
            <span role="columnheader">剩餘</span>
            <span role="columnheader">狀態</span>
          </div>

          <% @filtered_issues.each do |issue| %>
            <% status = burndown_status(issue) %>
            <details class="burndown-status-details">
              <summary class="burndown-status-summary">
                <%# data-label 供窄螢幕卡片式版面用（見 application.css 的
                    @media (max-width: 768px) 區塊），比照 305/306 既有表格的做法：欄位標籤
                    改由 CSS ::before 讀 data-label 印出，不需要每張卡片各自重複寫死標籤文字。 %>
                <span class="burndown-status-row" role="row">
                  <span role="cell"><%= "#{issue[:project]}／#{issue[:issue_title]}" %></span>
                  <span role="cell" data-label="負責人"><%= issue[:assignees].join("、") %></span>
                  <span role="cell" data-label="預估人時"><%= issue[:estimated_hours] %></span>
                  <span role="cell" data-label="已消耗"><%= burndown_consumed_hours(issue) || "—" %></span>
                  <span role="cell" data-label="剩餘"><%= burndown_remaining_hours(issue) || "—" %></span>
                  <span role="cell" data-label="狀態"><span class="status-badge status-<%= status[:key] %>"><%= status[:label] %></span></span>
                </span>
              </summary>
              <div class="burndown-status-detail">
                <%= render partial: "burndown_combo_chart", locals: { issue: issue } %>
              </div>
            </details>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>
<% end %>
