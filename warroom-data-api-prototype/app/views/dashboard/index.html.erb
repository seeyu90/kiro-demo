<% content_for :title, "戰情室 — 專案進度" %>

<header class="dashboard-header">
  <div class="header-top">
    <h1 class="dashboard-title">戰情室 <span>— 專案進度</span></h1>
    <button type="button" id="theme-toggle" class="theme-toggle" aria-label="切換至淺色模式">🌙 深色</button>
  </div>
</header>

<%# 麵包屑與篩選表單都移進 frame 裡（原本各自獨立在 header），統一成「標題 → 水平線 →
    麵包屑 → 篩選」的順序，跟 306/307/專案歷程一致。data-turbo-frame 讓送出只換掉下方
    project-content frame 的內容，瀏覽器網址列不會被填入篩選參數，也不會觸發整頁導覽。 %>
<%= turbo_frame_tag "project-content" do %>
  <p class="breadcrumb">
    <%= link_to "入口頁", "/", class: "back-link", data: { turbo_frame: "_top" } %>
    <span class="breadcrumb-sep">›</span>
    <span class="breadcrumb-current">專案進度</span>
  </p>

  <%= form_with url: "/dashboard", method: :get, class: "project-selector",
                data: { turbo_frame: "project-content" } do %>
    <div class="control-group">
      <label for="project">選擇專案：</label>
      <%= select_tag :project,
                     options_for_select([["全部專案", ""]] + @project_names.map { |name| [name, name] },
                                        @selected_project) %>
    </div>

    <fieldset class="type-filter">
      <%# legend 視覺上隱藏（見 application.css 的 .type-filter legend 註解），只留給螢幕
          閱讀器；看得到的標籤是下面的 .filter-group-label span，跟 checkbox 同一列排列，
          fieldset 才不會因為 legend 佔掉獨立一行而比其他篩選控制項高一截、對不齊。 %>
      <legend>任務類型</legend>
      <span class="filter-group-label" aria-hidden="true">任務類型</span>
      <%# 隱藏欄位：確保「全部取消勾選」時 params[:task_type] 仍會被送出（值為 [""]），
          與「完全沒有 task_type 參數」（首次載入，套用預設值）明確區分開來 %>
      <input type="hidden" name="task_type[]" value="">
      <% @task_types.each do |type| %>
        <label>
          <%= check_box_tag "task_type[]", type, @selected_types.include?(type), multiple: true, id: nil %>
          <%= type %>
        </label>
      <% end %>
    </fieldset>

    <fieldset class="scope-filter">
      <legend>範圍</legend>
      <span class="filter-group-label" aria-hidden="true">範圍</span>
      <label><%= radio_button_tag :scope, "all", @scope == "all" %> 全部</label>
      <label><%= radio_button_tag :scope, "due_this_week", @scope == "due_this_week" %> 本週到期（含已逾期）</label>
      <label><%= radio_button_tag :scope, "overdue", @scope == "overdue" %> 已逾期</label>
    </fieldset>

    <%# 依預計完成日期篩選，跟上面的「範圍」是兩個獨立篩選軸，同時套用；留白＝不限制。 %>
    <%= render "shared/date_range_filter", from: @selected_from, to: @selected_to, min: nil, max: nil %>

    <label class="incomplete-toggle">
      <%# 隱藏欄位：確保取消勾選時仍會送出 incomplete_only=0，
          Controller 用「是否等於 "0"」判斷，需仰賴此欄位才會被明確覆蓋為 false %>
      <input type="hidden" name="incomplete_only" value="0">
      <%= check_box_tag :incomplete_only, "1", @incomplete_only %>
      只顯示未完成
    </label>

    <%# margin-left:auto 把兩個按鈕推到同一行的最右側（filter row 用 flex-wrap，這兩個按鈕
        常常會自己獨立換到下一行，靠左黏在篩選項目下面不好看，置右比較符合一般慣例）。 %>
    <div class="filter-actions">
      <%= submit_tag "套用篩選", class: "apply-filters-btn" %>
      <%# name="refresh" 讓瀏覽器只在這個按鈕被點擊時才送出 refresh 參數（一般表單只送出被點擊的
          submit 按鈕的 name/value），藉此重用同一個表單、同一套 Turbo Frame／載入狀態行為，
          不需要另外一個獨立表單。注意：submit_tag 的第一個參數同時是按鈕顯示文字「和」送出的
          value，所以這裡不能額外傳 value: 選項覆蓋顯示文字，Controller 改用「有沒有這個參數」
          判斷，不比對特定字串值。 %>
      <%= submit_tag "重新整理資料", name: "refresh", class: "apply-filters-btn refresh-btn" %>
    </div>
  <% end %>

  <% if @error.present? %>
    <div class="error-message">
      <strong>錯誤：</strong><%= @error %>
    </div>
  <% else %>
    <% if @freshness_label.present? %>
      <p class="freshness-label"><%= @freshness_label %></p>
    <% end %>

    <div class="summary-bar">
      <div class="stat-item">
        <span class="stat-value"><%= @summary[:total] %></span>
        <span class="stat-label">任務總數</span>
      </div>
      <div class="stat-item">
        <span class="stat-value"><%= @summary[:completed] %></span>
        <span class="stat-label">已完成</span>
      </div>
      <div class="stat-item">
        <span class="stat-value"><%= @summary[:incomplete] %></span>
        <span class="stat-label">未完成</span>
      </div>
      <div class="stat-item stat-overdue">
        <span class="stat-value"><%= @summary[:overdue] %></span>
        <span class="stat-label">逾期</span>
      </div>
    </div>

    <% visible_data = @display_data.reject { |_, tasks| tasks.empty? } %>
    <% if visible_data.empty? %>
      <p class="empty-state">目前無資料</p>
    <% else %>
      <% visible_data.each do |project_name, tasks| %>
        <section class="project-block">
          <h2><%= project_name %></h2>
          <%= render partial: "project_block", locals: { tasks: tasks } %>
        </section>
      <% end %>
    <% end %>
  <% end %>
<% end %>
