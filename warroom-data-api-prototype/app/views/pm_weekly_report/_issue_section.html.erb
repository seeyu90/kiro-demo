<%# 單一專案的 306 議題表（欄位見需求 3.5）。到期日可能是 SLA 推算值，由
    pm_weekly_due_date_label 標示「（推算）」，不讓 PM 誤以為試算表有填。
    類型／狀態沿用 306 議題頁既有的 IssuesHelper 標籤，不另立一套配色。 %>
<table class="project-tasks">
  <thead>
    <tr>
      <th scope="col">議題編號</th>
      <th scope="col">主旨</th>
      <th scope="col">類型</th>
      <th scope="col">狀態</th>
      <th scope="col">負責人</th>
      <th scope="col">到期日</th>
    </tr>
  </thead>
  <tbody>
    <% items.each do |issue| %>
      <%= tag.tr(class: ("row-overdue" if variant == :overdue)) do %>
        <td><%= issue[:issue_id] %></td>
        <td>
          <span class="issue-subject-truncate" title="<%= issue[:subject] %>"><%= issue[:subject] %></span>
        </td>
        <td>
          <span class="attribution-badge <%= attribution_class(issue[:type]) %>"><%= attribution_label(issue[:type]) %></span>
        </td>
        <td>
          <span class="status-badge <%= issue_status_badge_class(issue[:status]) %>"><%= issue[:status].presence || "—" %></span>
        </td>
        <td><%= issue[:assigned_to].presence || "—" %></td>
        <td><%= pm_weekly_due_date_label(issue) %></td>
      <% end %>
    <% end %>
  </tbody>
</table>
