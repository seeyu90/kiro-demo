<div class="issue-section">
  <h3>階段追蹤例外（依客戶彙總）</h3>
  <p class="freshness-label">
    此區塊獨立於上方專案卡片：階段追蹤使用另一份試算表的專案代碼，目前無法可靠對應到上方的專案名稱，故按客戶彙總筆數，不勉強合併成同一張卡片。
  </p>

  <% if @phase_exceptions.empty? %>
    <p class="empty-state">目前無延誤、未完成或暫緩的階段。</p>
  <% else %>
    <div class="project-card-list">
      <% @phase_exceptions_by_customer.each do |group| %>
        <details class="project-card<%= " project-card-overdue" if group[:pending_count].positive? %>">
          <summary class="project-card-summary">
            <span class="project-card-name"><%= group[:customer] %></span>
            <span class="project-card-tags">
              <% if group[:pending_count].positive? %>
                <span class="tag overdue-tag">延誤／未完成 <%= group[:pending_count] %></span>
              <% end %>
              <% if group[:paused_count].positive? %>
                <span class="tag">暫緩 <%= group[:paused_count] %></span>
              <% end %>
            </span>
          </summary>

          <div class="project-card-body">
            <table class="project-tasks">
              <thead>
                <tr>
                  <th scope="col">專案代碼</th>
                  <th scope="col">議題</th>
                  <th scope="col">PM</th>
                  <th scope="col">目前階段</th>
                  <th scope="col">狀態</th>
                </tr>
              </thead>
              <tbody>
                <% group[:exceptions].each do |exception| %>
                  <tr class="<%= "row-overdue" unless exception[:paused] %>">
                    <td data-label="專案代碼"><%= exception[:project_code] %></td>
                    <td data-label="議題"><%= exception[:issue_label] %></td>
                    <td data-label="PM"><%= exception[:pm] || "—" %></td>
                    <td data-label="目前階段"><%= exception[:stage] || "—" %></td>
                    <td data-label="狀態">
                      <span class="tag <%= phase_tracking_status_class(exception[:status]) %>"><%= exception[:status] %></span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </details>
      <% end %>
    </div>
  <% end %>
</div>
