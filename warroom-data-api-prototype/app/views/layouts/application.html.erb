<!DOCTYPE html>
<html>
  <head>
    <script>
      (function () {
        try {
          var saved = localStorage.getItem("warroom-theme");
          if (saved === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
          }
        } catch (e) {
          // localStorage 不可用：靜默忽略，維持預設淺色
        }
      })();
    </script>
    <title><%= content_for(:title) || "戰情室 — 305 專案任務進度" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="戰情室">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="dashboard-container">
      <%= yield %>
    </div>

    <script>
      (function () {
        "use strict";
        var THEME_KEY = "warroom-theme";

        // 預設為淺色：只有明確標上 data-theme="dark" 才是深色（見 application.css 的主題變數）。
        function getCurrentTheme() {
          return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
        }

        function applyThemeToggleLabel(theme) {
          var btn = document.getElementById("theme-toggle");
          if (!btn) return;
          if (theme === "light") {
            btn.textContent = "☀️ 淺色";
            btn.setAttribute("aria-label", "切換至深色模式");
          } else {
            btn.textContent = "🌙 深色";
            btn.setAttribute("aria-label", "切換至淺色模式");
          }
        }

        function toggleTheme() {
          var next = getCurrentTheme() === "light" ? "dark" : "light";
          if (next === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
          } else {
            document.documentElement.removeAttribute("data-theme");
          }
          applyThemeToggleLabel(next);
          try {
            localStorage.setItem(THEME_KEY, next);
          } catch (e) {
            // localStorage 不可用：僅本次瀏覽切換有效
          }
        }

        // Turbo Drive 換頁時只替換 <body>，不會再次觸發 DOMContentLoaded（那個事件整個工作階段
        // 只發生一次），因此原本只綁 DOMContentLoaded 的寫法，在使用者從入口頁點進任一頁面之後，
        // 新的按鈕元素身上就沒有任何 click 監聽器，按了完全沒反應——這就是「有時候切換按鈕會失效」
        // 的原因（重新整理頁面後又正常，因為那是一次真正的初次載入）。改為同時監聽 turbo:load。
        //
        // 不改用 document 層的事件委派：body 內的 <script> 在每次 Turbo 換頁都會重新執行，
        // 委派會一次次疊加同一個監聽器，變成一次點擊切換兩次（看起來同樣像沒反應）。綁在按鈕
        // 元素上則沒有這個問題（每次換頁都是全新的元素），再用 dataset 旗標防止重複綁定。
        function setupThemeToggle() {
          applyThemeToggleLabel(getCurrentTheme());
          var btn = document.getElementById("theme-toggle");
          if (!btn || btn.dataset.themeBound) return;
          btn.dataset.themeBound = "1";
          btn.addEventListener("click", toggleTheme);
        }

        document.addEventListener("DOMContentLoaded", setupThemeToggle);
        document.addEventListener("turbo:load", setupThemeToggle);
      })();
    </script>

    <script>
      (function () {
        "use strict";
        // 篩選表單只更新對應的 Turbo Frame（見 dashboard/index.html.erb、issues/index.html.erb，
        // 後者一個頁面有兩個獨立表單），送出期間停用該表單內所有送出按鈕、把「實際被點擊的
        // 那個」文字改成載入中提示，完成後全部恢復，避免使用者以為沒反應而重複點擊。
        //
        // 用事件委派綁在 document 上（而非個別表單節點）：issues/index.html.erb 的表單位於
        // 會被 Turbo Frame 替換掉的 turbo-frame 內，每次篩選送出後表單都是全新的 DOM 節點，
        // 直接綁在表單節點上的監聽器只在第一次送出後就失效；Turbo 的 submit 事件會冒泡到
        // document，委派可以涵蓋每一次送出，不論表單節點是否被重新渲染過。
        var BUSY_LABEL = "套用中…";

        document.addEventListener("turbo:submit-start", function (event) {
          var form = event.target.closest(".project-selector");
          if (!form) return;
          var buttons = form.querySelectorAll(".apply-filters-btn");
          if (!buttons.length) return;

          var submission = event.detail && event.detail.formSubmission;
          var submitter = submission && submission.submitter;

          buttons.forEach(function (btn) {
            btn.dataset.defaultLabel = btn.textContent;
            btn.disabled = true;
            if (btn === submitter) btn.textContent = BUSY_LABEL;
          });
        });

        document.addEventListener("turbo:submit-end", function (event) {
          var form = event.target.closest(".project-selector");
          if (!form) return;

          form.querySelectorAll(".apply-filters-btn").forEach(function (btn) {
            btn.disabled = false;
            if (btn.dataset.defaultLabel) btn.textContent = btn.dataset.defaultLabel;
          });
        });

        // 快取命中或本機測試時，篩選請求常常快到 turbo-frame[busy] 的轉圈圈只閃一下就消失，
        // 看起來像畫面故障而不是「有在載入」。強制轉圈圈至少顯示 MIN_LOADING_MS。
        //
        // 讀 Turbo 原始碼確認過兩種做法都行不通：
        // 1. turbo:before-frame-render 的 preventDefault()+resume() 只會延後「換上新內容」，
        //    busy 屬性是在表單送出完成時（FormSubmission#requestFinished 呼叫
        //    delegate.formSubmissionFinished）就移除，跟 render/resume 是兩條獨立路徑。
        // 2. 在 turbo:submit-end 監聽器裡 setAttribute("busy") 也沒用：Turbo 是先
        //    dispatch "turbo:submit-end"，接著在「同一個呼叫堆疊」馬上呼叫
        //    formSubmissionFinished 移除 busy——我們在監聽器裡補上的 busy 屬性會被這個
        //    緊接在後的內部呼叫立刻蓋掉，肉眼看不出效果。
        // 解法：把「補回 busy」這件事丟到下一個 tick（setTimeout 0），確保排在 Turbo 自己
        // 的 formSubmissionFinished 之後才執行，這樣補上去的 busy 才不會被蓋掉。
        var MIN_LOADING_MS = 1000;

        document.addEventListener("turbo:submit-start", function (event) {
          var form = event.target.closest(".project-selector");
          if (!form) return;
          var frame = document.getElementById(form.dataset.turboFrame);
          if (frame) frame.dataset.loadingStartedAt = String(Date.now());
        });

        document.addEventListener("turbo:submit-end", function (event) {
          var form = event.target.closest(".project-selector");
          if (!form) return;
          var frame = document.getElementById(form.dataset.turboFrame);
          if (!frame) return;

          var startedAt = Number(frame.dataset.loadingStartedAt);
          delete frame.dataset.loadingStartedAt;
          if (!startedAt) return;

          var remaining = MIN_LOADING_MS - (Date.now() - startedAt);
          if (remaining <= 0) return;

          setTimeout(function () {
            frame.setAttribute("busy", "");
            setTimeout(function () {
              frame.removeAttribute("busy");
            }, remaining);
          }, 0);
        });
      })();
    </script>
  </body>
</html>
