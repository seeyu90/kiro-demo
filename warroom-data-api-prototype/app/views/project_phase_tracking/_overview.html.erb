<%# 2026-08-25 使用者要求簡化篩選列：拿掉「只顯示未完成」勾選框（狀態下拉已經有「未完成」／
    「延誤未完成」可選，兩個控制項功能重疊，且狀態下拉現在預設就是「未完成」，見 Controller
    的 resolve_status）、拿掉排序選單（固定依預計完成日期排序，不給選）、拿掉「重新整理資料」
    按鈕與資料新鮮度提示（n8n 一天只同步一次，按了也沒用，新鮮度提示也沒有實際參考價值）。
    拿掉這些之後控制項變少，「套用篩選」自然跟其他欄位排在同一行（.project-selector 本來就是
    flex-wrap，行數是「內容塞不塞得下」決定的，不是寫死兩行）。 %>
<%= form_with url: "/project_phase_tracking", method: :get, class: "project-selector",
              data: { turbo_frame: "project-phase-tracking-content" } do %>
  <%= hidden_field_tag :view, @view %>
  <div class="control-group">
    <label for="year">年度：</label>
    <%= select_tag :year,
                   options_for_select([ [ "全部年度", "" ] ] + @available_years.map { |y| [ y, y ] }, @selected_year) %>
  </div>
  <div class="control-group">
    <label for="customer">客戶：</label>
    <%= select_tag :customer,
                   options_for_select([ [ "全部客戶", "" ] ] + @customers.map { |c| [ c, c ] }, @selected_customer) %>
  </div>
  <div class="control-group">
    <label for="status">狀態：</label>
    <%= select_tag :status,
                   options_for_select([ [ "全部狀態", "" ] ] + @statuses.map { |s| [ s, s ] }, @selected_status) %>
  </div>
  <div class="control-group">
    <label for="pm">PM：</label>
    <%= select_tag :pm, options_for_select([ [ "全部 PM", "" ] ] + @pms.map { |p| [ p, p ] }, @selected_pm) %>
  </div>
  <div class="control-group">
    <label for="q">議題名稱／ID：</label>
    <%= text_field_tag :q, @selected_query, placeholder: "搜尋議題名稱或 ID" %>
  </div>
  <%= submit_tag "套用篩選", class: "apply-filters-btn" %>
<% end %>

<% if @profiles_unavailable %>
  <p class="section-note section-note-standalone">客戶／PM 對照資料（300_員工專案）暫時無法取得，該欄位顯示為 —，不影響階段追蹤資料本身</p>
<% end %>

<div class="view-toggle" role="group" aria-label="檢視模式切換">
  <%= link_to "清單",
              url_for(request.query_parameters.merge(view: "list")),
              class: "view-toggle-btn #{'active' if @view == 'list'}" %>
  <%= link_to "甘特圖",
              url_for(request.query_parameters.merge(view: "gantt")),
              class: "view-toggle-btn #{'active' if @view == 'gantt'}" %>
</div>

<section class="issue-section">
  <% if @cards.empty? %>
    <p class="empty-state">目前無符合條件的專案</p>
  <% elsif @view == "gantt" %>
    <%= render partial: "gantt_legend" %>
    <%= render partial: "overview_gantt", locals: { cards: @cards } %>
  <% else %>
    <%= render partial: "overview_list", locals: { cards: @cards } %>
  <% end %>
</section>
