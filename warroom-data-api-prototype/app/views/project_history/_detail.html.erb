<%= form_with url: "/project_history", method: :get, class: "project-selector",
              data: { turbo_frame: "project-history-content" } do %>
  <div class="control-group">
    <label for="project">專案：</label>
    <%= select_tag :project, options_for_select(@project_names.map { |p| [ p, p ] }, @selected_project) %>
  </div>
  <%= submit_tag "切換專案", class: "apply-filters-btn" %>
<% end %>

<h2><%= @selected_project %></h2>

<section class="issue-section">
  <h2>花費工時趨勢</h2>
  <div class="trend-chart-wrap">
    <%= render partial: "simple_trend_chart", locals: {
          records: to_trend_records(@work_hours_series, :hours),
          empty_text: "所選專案無工時資料",
          aria_label: "花費工時趨勢圖",
          tooltip_label: "花費工時"
        } %>
  </div>
</section>

<section class="issue-section">
  <h2>每週進度達成率（人時燃盡）</h2>
  <%= render partial: "burndown/burndown_chart",
             locals: { title: "#{@selected_project} 專案彙總", actual_series: @actual_series, ideal_series: @ideal_series } %>
</section>

<section class="issue-section">
  <h2>測試問題趨勢</h2>
  <div class="trend-chart-wrap">
    <%= render partial: "simple_trend_chart", locals: {
          records: to_trend_records(@testing_trend, :count),
          empty_text: "所選專案無測試問題資料",
          aria_label: "測試問題趨勢圖",
          tooltip_label: "測試問題"
        } %>
  </div>
</section>

<section class="issue-section">
  <h2>客訴議題狀態</h2>
  <% if @complaint_summary[:resolved_count].zero? && @complaint_summary[:unresolved_count].zero? %>
    <p class="empty-state">所選專案無客訴議題</p>
  <% else %>
    <div class="summary-bar">
      <div class="stat-item">
        <span class="stat-value"><%= @complaint_summary[:resolved_count] %></span>
        <span class="stat-label">已解決客訴</span>
      </div>
      <div class="stat-item <%= "stat-overdue" if @complaint_summary[:unresolved_count] > 0 %>">
        <span class="stat-value"><%= @complaint_summary[:unresolved_count] %></span>
        <span class="stat-label">未解決客訴</span>
      </div>
    </div>

    <% if @complaint_summary[:unresolved_list].any? %>
      <p class="breakdown-heading">未解決客訴清單</p>
      <table class="project-tasks">
        <thead>
          <tr>
            <th scope="col">議題編號</th>
            <th scope="col">主旨</th>
            <th scope="col">狀態</th>
            <th scope="col">建立日期</th>
          </tr>
        </thead>
        <tbody>
          <% @complaint_summary[:unresolved_list].each do |issue| %>
            <tr>
              <td data-label="議題編號">
                <%= link_to issue[:issue_id], "https://redmine.amastek.com.tw/issues/#{issue[:issue_id]}",
                            class: "issue-id-link", target: "_blank", rel: "noopener noreferrer" %>
              </td>
              <td data-label="主旨"><%= issue[:subject] %></td>
              <td data-label="狀態"><%= issue[:status] %></td>
              <td data-label="建立日期"><%= issue[:start_date] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>
</section>
