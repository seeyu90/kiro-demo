<% if daily_kpi.empty? %>
  <p class="empty-state">目前無資料</p>
<% else %>
  <% points = trend_chart_points(daily_kpi) %>
  <svg viewBox="0 0 640 200" class="trend-svg" role="img" aria-label="每日議題總數趨勢圖">
    <polyline points="<%= trend_chart_polyline(points) %>" class="trend-line"></polyline>
    <% points.each do |point| %>
      <circle cx="<%= point[:x] %>" cy="<%= point[:y] %>" r="4" class="trend-point" tabindex="0">
        <title><%= point[:date] %> ｜ 客訴 <%= point[:complaint] %>・測試 <%= point[:testing] %>・其他 <%= point[:other] %>・總計 <%= point[:total] %></title>
      </circle>
    <% end %>
  </svg>
<% end %>
