<% if issues.empty? %>
  <p class="empty-state">目前無符合條件的議題</p>
<% else %>
  <table class="project-tasks">
    <thead>
      <tr>
        <th>議題／專案</th>
        <th>類別</th>
        <th>主旨</th>
        <th>狀態</th>
        <th>負責人</th>
        <th>時程與天數</th>
        <th>花費時間</th>
      </tr>
    </thead>
    <tbody>
      <% issues.each do |issue| %>
        <tr>
          <td>
            <%= link_to issue[:issue_id], "https://redmine.amastek.com.tw/issues/#{issue[:issue_id]}",
                        class: "issue-id-link", target: "_blank", rel: "noopener noreferrer" %>
            <br>
            <span class="issue-project-sub"><%= issue[:project] %></span>
          </td>
          <td>
            <span class="attribution-badge <%= attribution_class(issue[:type]) %>">
              <%= attribution_label(issue[:type]) %>
            </span>
          </td>
          <td>
            <span class="issue-subject-truncate" title="<%= issue[:subject] %>"><%= issue[:subject] %></span>
          </td>
          <td>
            <span class="status-badge <%= issue_status_badge_class(issue[:status]) %>"><%= issue[:status] %></span>
          </td>
          <td>
            <% if issue[:assigned_to].present? %>
              <span class="assignee-avatar" aria-hidden="true"><%= issue[:assigned_to].first %></span>
              <%= issue[:assigned_to] %>
            <% else %>
              —
            <% end %>
          </td>
          <td><%= issue_timeline_label(issue) %></td>
          <td>
            <% if issue[:total_hours].to_f.zero? %>
              <span class="total-hours-empty">0h</span>
            <% else %>
              <%= number_with_precision(issue[:total_hours], precision: 2, strip_insignificant_zeros: true) %>h
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
