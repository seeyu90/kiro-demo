<% if rows.empty? %>
  <p class="empty-state">所選期間無議題資料</p>
<% else %>
  <table class="project-tasks issue-tasks">
    <thead>
      <tr>
        <th>專案</th>
        <th><%= breakdown_sort_link(:complaint, "客訴") %></th>
        <th><%= breakdown_sort_link(:testing, "測試") %></th>
        <th><%= breakdown_sort_link(:other, "其他") %></th>
        <th><%= breakdown_sort_link(:total, "總計") %></th>
      </tr>
    </thead>
    <tbody>
      <%# data-label 供窄螢幕的卡片式版面當欄位標籤用（見 application.css 的 @media 區塊）——
          這張表原本沒加，768px 以下每一列會變成沒有標籤的裸數字，看不出哪個數字是客訴、
          哪個是測試。 %>
      <% rows.each do |row| %>
        <tr>
          <td><%= row[:project] %></td>
          <td data-label="客訴"><%= row[:complaint] %></td>
          <td data-label="測試"><%= row[:testing] %></td>
          <td data-label="其他"><%= row[:other] %></td>
          <td data-label="總計"><%= row[:total] %></td>
        </tr>
      <% end %>
    </tbody>
    <%# 小計列：純加總 rows 已經算好的每一欄，不是另外呼叫 Actor 重算——這裡只有純顯示層的
        加總，沒有新的業務邏輯，不需要為此另開一個 Actor 輸出。排序點擊只作用在 tbody 的列，
        小計不隨排序移動，故獨立放在 tfoot。 %>
    <tfoot>
      <tr class="project-breakdown-subtotal">
        <td>小計</td>
        <td data-label="客訴"><%= rows.sum { |row| row[:complaint] } %></td>
        <td data-label="測試"><%= rows.sum { |row| row[:testing] } %></td>
        <td data-label="其他"><%= rows.sum { |row| row[:other] } %></td>
        <td data-label="總計"><%= rows.sum { |row| row[:total] } %></td>
      </tr>
    </tfoot>
  </table>
<% end %>
